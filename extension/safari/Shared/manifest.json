{
  "manifest_version": 3,
  "name": "exfetch",
  "version": "0.2.0",
  "description": "Browser agent bridge for exfetch \u2014 gives LLM agents authenticated web access",
  "permissions": [
    "scripting",
    "tabs",
    "cookies",
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
